<% layout("/layouts/boilerplate.ejs") -%>
<body>
    <h3>listing Details:</h3>
    <ul>
        <li><%=listing.title%></li>
        <li><%=listing.description%></li>
        <li>&#8377;<%= listing.price%></li>
        <li><%=listing.location%></li>
